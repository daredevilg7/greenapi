# Только для локальных тестов. Без префикса VITE_: ключи не попадут в сборку.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_URL=
# Получатель, которому разрешено отправить тестовое сообщение
GREEN_API_TEST_PHONE=
# Режимы: read (подключение), send (одно сообщение), roundtrip (отправка + ответ)
# Повторная проверка ответа без отправки: npm run test:api:receive
GREEN_API_TEST_MODE=read
